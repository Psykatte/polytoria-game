<!-- This tool analyses the game project; it must NEVER be referenced by it. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Polytoria.Docs.Generator</RootNamespace>
  </PropertyGroup>

  <!-- Runtime dependencies. -->
  <ItemGroup>

    <!-- Provides `MSBuildLocator.RegisterDefaults()` to find the SDK's MSBuild at runtime -->
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" PrivateAssets="all" />

    <!-- Roslyn: Generates a full semantic model of the source code. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.3.0" PrivateAssets="all" />

    <!-- Lets Roslyn open `.csproj`s exactly as the compiler would see them. -->
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.3.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- MSBuild is supplied at runtime by the target SDK (MSBuildLocator.RegisterDefaults), so keep
  the NuGet MSBuild assemblies out of the output entirely. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Build" Version="18.6.3" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" Version="18.6.3" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="18.6.3" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.6.3" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <!-- Transitive patches. -->
  <ItemGroup>
  
    <!-- NU1903: A transitive of Microsoft.Build.Tasks.Core (System.Security.Cryptography.Xml)
    carries an advisory. This vulnerability is patched in version 10.0.6. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.6" PrivateAssets="all" />

    <!-- A transitive of Microsoft.CodeAnalysis.Workspaces.MSBuild (Microsoft.NET.StringTools) can
    cause errors at run-time. -->
    <PackageReference Include="Microsoft.NET.StringTools" Version="18.6.3" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

</Project>
